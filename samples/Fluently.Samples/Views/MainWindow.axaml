<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluently="https://github.com/taner04/fluently"
        xmlns:vm="using:Fluently.Samples.ViewModels"
        x:Class="Fluently.Samples.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Fluently Samples"
        Width="640" Height="420">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="16">
            <Button Content="Back" Command="{Binding GoBackCommand}" IsEnabled="{Binding Navigation.CanGoBack}" />
            <TextBlock Text="Fluently Samples" FontSize="20" VerticalAlignment="Center" />
        </StackPanel>
        <fluently:NavigationHost Navigation="{Binding Navigation}" Margin="16">
            <fluently:NavigationHost.PageTransition>
                <CrossFade Duration="0:0:0.15" />
            </fluently:NavigationHost.PageTransition>
        </fluently:NavigationHost>
    </DockPanel>
</Window>
