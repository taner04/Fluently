<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluently.Samples.ViewModels"
             x:Class="Fluently.Samples.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Pick an item" FontSize="16" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                    <Button Content="{Binding StringFormat='Item {0}'}"
                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenCommand}"
                            CommandParameter="{Binding}"
                            Margin="0,0,0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
