<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluently.Samples.ViewModels"
             x:Class="Fluently.Samples.Views.DetailsView"
             x:DataType="vm:DetailsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Item, StringFormat='Details of item {0}'}" FontSize="16" />
        <TextBlock Text="Opened with a typed navigation parameter. Use Back to return." />
    </StackPanel>
</UserControl>
