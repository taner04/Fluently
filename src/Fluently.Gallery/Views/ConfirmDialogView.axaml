<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluently.Gallery.ViewModels"
             x:Class="Fluently.Gallery.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">
    <Border Classes="dialog">
        <StackPanel Spacing="24">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Request.Title}" Classes="subtitle-heading" />
                <TextBlock Text="{Binding Request.Message}" Classes="subtitle" />
            </StackPanel>
            <UniformGrid Columns="2" ColumnSpacing="8">
                <Button Content="{Binding Request.ConfirmText}" Command="{Binding ConfirmCommand}" Classes="accent"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
