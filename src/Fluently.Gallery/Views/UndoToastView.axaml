<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluently.Gallery.ViewModels"
             x:Class="Fluently.Gallery.Views.UndoToastView"
             x:DataType="vm:UndoToastViewModel">
    <Border Classes="toast" Width="360">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Item deleted" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" Classes="accent"
                    VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
