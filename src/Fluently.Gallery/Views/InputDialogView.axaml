<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluently.Gallery.ViewModels"
             x:Class="Fluently.Gallery.Views.InputDialogView"
             x:DataType="vm:InputDialogViewModel">
    <Border Classes="dialog">
        <StackPanel Spacing="24">
            <TextBlock Text="{Binding Title}" Classes="subtitle-heading" />
            <TextBox Text="{Binding Text}" PlaceholderText="New name" />
            <UniformGrid Columns="2" ColumnSpacing="8">
                <Button Content="Rename" Command="{Binding AcceptCommand}" Classes="accent" IsDefault="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
