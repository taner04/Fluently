<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluently="using:Fluently"
             x:Class="Fluently.Gallery.Views.ToastView"
             x:DataType="fluently:Toast">
    <Border Name="Card" Classes="toast" Width="380" Padding="0">
        <Panel>
            <Border Classes="toast-tint" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14,8,16">
                <PathIcon Classes="toast-icon" Margin="0,2,14,0" />
                <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Classes="toast-message" />
                </StackPanel>
                <Button Grid.Column="2" Classes="toast-close" Click="OnCloseClick"
                        ToolTip.Tip="Close" AutomationProperties.Name="Close">
                    <PathIcon Width="10" Height="10"
                              Data="M2.59,1.17L8,6.59L13.41,1.17L14.83,2.59L9.41,8L14.83,13.41L13.41,14.83L8,9.41L2.59,14.83L1.17,13.41L6.59,8L1.17,2.59Z" />
                </Button>
            </Grid>
        </Panel>
    </Border>
</UserControl>
