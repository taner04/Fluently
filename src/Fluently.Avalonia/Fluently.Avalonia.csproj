<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Fluently.Avalonia</PackageId>
        <RootNamespace>Fluently</RootNamespace>
        <Description>Avalonia integration for Fluently: shows the views registered with AddFluentlyViews() and the current page in a NavigationHost.</Description>
        <PackageTags>mvvm;navigation;avalonia</PackageTags>
        <PackageValidationBaselineVersion>0.2.1</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <!-- PrivateAssets="none" passes the view generator in Fluently.Core on to apps that only reference Fluently.Avalonia. -->
        <ProjectReference Include="..\Fluently.Core\Fluently.Core.csproj" PrivateAssets="none"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Fluently.Avalonia.UnitTests"/>
    </ItemGroup>

</Project>
