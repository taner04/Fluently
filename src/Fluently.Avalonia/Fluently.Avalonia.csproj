<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Fluently.Avalonia</PackageId>
        <RootNamespace>Fluently</RootNamespace>
        <Description>Avalonia integration for Fluently: a ViewLocator that shows the views registered by the Fluently.Core source generator, a NavigationHost that shows the current page, a DialogHost that shows open dialogs, a ToastHost that shows toasts, a ViewFor base class for views, and a FluentWindow with a TitleBar and a NavigationPane that navigates and follows the navigation service.</Description>
        <PackageTags>mvvm;navigation;avalonia</PackageTags>
        <PackageValidationBaselineVersion>0.3.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <!-- PrivateAssets="none" passes the view generator in Fluently.Core on to apps that only reference Fluently.Avalonia. -->
        <ProjectReference Include="..\Fluently.Core\Fluently.Core.csproj" PrivateAssets="none"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Fluently.Avalonia.UnitTests"/>
    </ItemGroup>

</Project>
