<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Fluently.Avalonia</PackageId>
        <RootNamespace>Fluently</RootNamespace>
        <Description>Avalonia integration for Fluently: view-model-first view location and a navigation host.</Description>
        <PackageTags>mvvm;navigation;avalonia</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fluently.Core\Fluently.Core.csproj"/>
        <ProjectReference Include="..\Fluently.Avalonia.SourceGenerator\Fluently.Avalonia.SourceGenerator.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(ArtifactsPath)/bin/Fluently.Avalonia.SourceGenerator/$(Configuration.ToLowerInvariant())/Fluently.Avalonia.SourceGenerator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Fluently.Avalonia.UnitTests"/>
    </ItemGroup>

</Project>
